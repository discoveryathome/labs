{
  "schema": "discover/v0",
  "title": "Low-Autocorrelation Binary Sequences — local pilot",
  "summary": "Exact witness verification and bounded search against audited 2025–2026 LABS energy constructions. Local proposal; maintainer unassigned.",
  "domains": [
    "mathematics",
    "algorithms",
    "combinatorial-optimization"
  ],
  "license": "MIT",
  "maintainers": [
    {
      "name": "UNASSIGNED — vacancy, no consenting maintainer"
    }
  ],
  "canonical_repo": "urn:discoveryathome:local:labs-pilot",
  "entry": {
    "agents": "AGENTS.md",
    "project": "DISCOVERY.md",
    "contributing": "docs/VERIFY.md",
    "brief": "README.md"
  },
  "frontier": "discover/frontier.json",
  "catalog": "discover/catalog.json",
  "priority_log": "discover/priority-log.md",
  "ledger": "discover/ledger.jsonl",
  "packages": "research/*/",
  "session": {
    "default_minutes": 15,
    "orient_fraction": 0.2,
    "verify_fraction": 0.25
  },
  "permissions": {
    "post_messages": false,
    "open_prs": false,
    "maintainer_only": [
      "merge",
      "change-frontier",
      "remote-creation",
      "push",
      "hub-listing"
    ]
  },
  "verification_profile": "exact-certificate",
  "hubs": [
    {
      "hub": "*",
      "list": false,
      "push": []
    }
  ],
  "credit": {
    "policy": "Credit original witness authors per row; credit contributors and AI assistance in result packages and CONTRIBUTORS.md. No authorship promise.",
    "kinds": [
      "contributors-file",
      "citation"
    ]
  },
  "review": {
    "paused": true,
    "note": "No maintainer has consented; local proposal only, no review capacity declared."
  },
  "picker": {
    "command": [
      "python3",
      "scripts/pick.py",
      "--seed",
      "{seed}"
    ]
  },
  "requirements": {
    "ram_gb": 1,
    "disk_gb": 1,
    "note": "Python >=3.10; C++17 and make for solver. No GPU or external Python packages."
  },
  "process_changed_on": "2026-10-20"
}
